{
  "name": "kank",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:critical": "ng test --watch=false --browsers=ChromeHeadless --include=src/app/components/register-client/register-client.component.spec.ts --include=src/app/components/new-cycle-register/new-cycle-register.component.spec.ts --include=src/app/components/payment/payment.component.spec.ts --include=src/app/components/payment-savings/payment-savings.component.spec.ts --include=src/app/components/tracking/tracking.component.spec.ts --include=src/app/services/data.service.spec.ts --include=src/app/utils/pending-loan-budget.util.spec.ts --include=src/app/utils/payment-responsibility-document.util.spec.ts --include=src/app/utils/weekly-payment-target.util.spec.ts",
    "test:functions": "npm --prefix functions test",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project demo-kank-storage-rules \"node --test test/storage.rules.test.cjs\"",
    "test:stability": "npm run test:storage-rules && npm run test:critical && npm run test:functions && npm run build",
    "deploy:storage:safe": "firebase deploy --only storage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.4",
    "@angular/common": "^16.2.4",
    "@angular/compiler": "^16.2.4",
    "@angular/core": "^16.2.4",
    "@angular/fire": "^7.6.1",
    "@angular/forms": "^16.2.4",
    "@angular/platform-browser": "^16.2.4",
    "@angular/platform-browser-dynamic": "^16.2.4",
    "@angular/router": "^16.2.4",
    "@angular/service-worker": "^16.2.12",
    "angular-plotly.js": "^5.2.2",
    "exifr": "^7.1.3",
    "firebase": "^10.3.1",
    "heic2any": "^0.0.4",
    "mediainfo.js": "^0.3.5",
    "pdfmake": "^0.2.9",
    "plotly.js-basic-dist": "^2.35.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.1",
    "@angular/cli": "~16.2.1",
    "@angular/compiler-cli": "^16.2.4",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/emscripten": "^1.40.1",
    "@types/jasmine": "~4.3.0",
    "@types/node": "18.17.19",
    "@types/pdfmake": "^0.2.8",
    "@types/plotly.js": "^2.35.5",
    "@types/plotly.js-basic-dist": "^1.54.4",
    "@types/plotly.js-dist-min": "^2.3.2",
    "autoprefixer": "^10.4.14",
    "css-loader": "^7.1.2",
    "firebase-tools": "^12.9.1",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "postcss": "^8.4.27",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.3.3",
    "typescript": "~4.9.4"
  }
}
