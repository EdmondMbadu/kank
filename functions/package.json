{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "firestore-v2:dry-run": "node scripts/firestore-v2-migrate.js",
    "firestore-v2:control": "node scripts/firestore-v2-control.js",
    "firestore-v2:smoke": "node scripts/firestore-v2-smoke.js",
    "firestore-v2:benchmark": "node scripts/firestore-v2-benchmark.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/firestore": "^8.0.0",
    "africastalking": "^0.7.3",
    "firebase-admin": "^11.8.0",
    "firebase-functions": "^4.3.1",
    "twilio": "^5.4.0"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
