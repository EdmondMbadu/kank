rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAppAdmin() {
      return signedIn() &&
        !isPortalClient() &&
        exists(currentUserPath()) &&
        (
          get(currentUserPath()).data.admin == 'true' ||
          (
            get(currentUserPath()).data.roles is list &&
            get(currentUserPath()).data.roles.hasAny(['admin'])
          )
        );
    }

    function isPortalClient() {
      return signedIn() &&
        ('portalClient' in request.auth.token) &&
        request.auth.token.portalClient == true;
    }

    function portalOwnerUid() {
      return isPortalClient() &&
        ('ownerUid' in request.auth.token) ?
        request.auth.token.ownerUid :
        null;
    }

    function portalClientUid() {
      return isPortalClient() &&
        ('clientUid' in request.auth.token) ?
        request.auth.token.clientUid :
        null;
    }

    function isRestrictedTopCollection(topCollection) {
      return topCollection == 'users' ||
        topCollection == 'clientLoginOtps' ||
        topCollection == 'clientPortalSessions' ||
        topCollection == 'mobileMoneyTransactionLookup' ||
        topCollection == 'management' ||
        topCollection == 'remainingLoanMonthEnds' ||
        topCollection == 'card_sms_settings' ||
        topCollection == 'moneyAvailabilityPolicies' ||
        topCollection == 'performanceMetricSettings' ||
        topCollection == 'investigationDocuments';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || (signedIn() && !isPortalClient());
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId) ||
        (
          signedIn() &&
          !isPortalClient() &&
          resource != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'monthBudget'
          ]) &&
          (!('monthBudget' in request.resource.data) ||
            request.resource.data.monthBudget is string)
        ) ||
        (
          signedIn() &&
          !isPortalClient() &&
          resource != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'teamCode'
          ]) &&
          (!('teamCode' in request.resource.data) ||
            request.resource.data.teamCode is string)
        );

      match /employees/{employeeId} {
        allow create, update: if isOwner(userId) ||
          (signedIn() && !isPortalClient());
      }

      match /employees/{employeeId}/attendance/{dateISO} {
        allow read, write: if isOwner(userId) ||
          (signedIn() && !isPortalClient());

        match /attachments/{attachmentId} {
          allow read, write: if isOwner(userId) ||
            (signedIn() && !isPortalClient());
        }
      }

      // Employee credits and transport receipts are managed from the same
      // cross-site administration views as the employee record itself.
      match /employees/{employeeId}/auditReceipts/{receiptId} {
        allow read, write: if isOwner(userId) ||
          (signedIn() && !isPortalClient());
      }

      // Location-level transport receipts are administered from the central
      // team ranking view, including when the administrator belongs to a
      // different location.
      match /transportReceipts/{receiptId} {
        allow read, write: if isOwner(userId) ||
          (signedIn() && !isPortalClient());
      }

      match /clients/{clientId} {
        allow read: if isOwner(userId) ||
          (signedIn() && !isPortalClient()) ||
          (isPortalClient() &&
            portalOwnerUid() == userId &&
            portalClientUid() == clientId);
        allow update: if signedIn() &&
          !isPortalClient() &&
          resource != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'comments',
            'galleryPictures',
            'recoveredAwayDebts',
            'debtRecognized',
            'notifiedForPolice',
            'profession'
          ]) &&
          (!('comments' in request.resource.data) ||
            request.resource.data.comments is list) &&
          (!('galleryPictures' in request.resource.data) ||
            request.resource.data.galleryPictures is map) &&
          (!('debtRecognized' in request.resource.data) ||
            request.resource.data.debtRecognized is string) &&
          (!('notifiedForPolice' in request.resource.data) ||
            request.resource.data.notifiedForPolice is bool) &&
          (!('profession' in request.resource.data) ||
            request.resource.data.profession is string) ||
          (
            isAppAdmin() &&
            resource != null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'vitalStatus'
            ]) &&
            (!('vitalStatus' in request.resource.data) ||
              request.resource.data.vitalStatus is string)
          );
      }

      match /investigationDays/{dayKey} {
        allow read: if isOwner(userId) || (signedIn() && !isPortalClient());

        allow create, update: if signedIn() &&
          !isPortalClient() &&
          request.resource.data.keys().hasOnly([
            'dateKey',
            'summary',
            'comments',
            'updatedAt'
          ]) &&
          (!('summary' in request.resource.data) ||
            request.resource.data.summary is string) &&
          (!('comments' in request.resource.data) ||
            request.resource.data.comments is list);
      }

      match /clientFeedbackDays/{dayKey} {
        allow read: if isOwner(userId) || (signedIn() && !isPortalClient());

        allow create, update: if signedIn() &&
          !isPortalClient() &&
          request.resource.data.keys().hasOnly([
            'dateKey',
            'entries',
            'updatedAt'
          ]) &&
          (!('dateKey' in request.resource.data) ||
            request.resource.data.dateKey is string) &&
          (!('entries' in request.resource.data) ||
            request.resource.data.entries is list) &&
          (!('updatedAt' in request.resource.data) ||
            request.resource.data.updatedAt is string);
      }

      match /{document=**} {
        allow read: if isOwner(userId) || (signedIn() && !isPortalClient());
        allow write: if isOwner(userId);
      }
    }

    // Collection-group access used by the cash-flow ranking. The UI gates the
    // ranking with the administrator word stored for the current browser
    // session. Firestore cannot inspect sessionStorage, so authenticated staff
    // must be allowed here while portal-client sessions remain excluded.
    match /{path=**}/dayTotals/{dayId} {
      allow read: if signedIn() && !isPortalClient();
    }

    match /clientLoginOtps/{docId} {
      allow read, write: if false;
    }

    match /clientPortalSessions/{docId} {
      allow read, write: if false;
    }

    match /mobileMoneyTransactionLookup/{docId} {
      allow read, write: if false;
    }

    match /payment_reminder_logs/{docId} {
      allow read: if signedIn() && !isPortalClient();
      allow write: if false;
    }

    match /payment_reminder_settings/{docId} {
      allow read, write: if signedIn() && !isPortalClient();
    }

    // The card SMS threshold is visible to authenticated staff, but only an
    // application administrator can enable automation or change the amount.
    match /card_sms_settings/{docId} {
      allow read: if signedIn() && !isPortalClient();
      allow write: if isAppAdmin();
    }

    match /presenceExceptionMonths/{monthKey} {
      allow read, write: if signedIn() && !isPortalClient();
    }

    match /moneyAvailabilityPolicies/{policyId} {
      allow read: if signedIn() && !isPortalClient();
      allow write: if isAppAdmin();

      match /{subPath=**} {
        allow read: if signedIn() && !isPortalClient();
        allow write: if isAppAdmin();
      }
    }

    match /performanceMetricSettings/{settingsId} {
      allow read: if signedIn() && !isPortalClient();
      allow write: if isAppAdmin();
    }

    match /remainingLoanMonthEnds/{periodKey} {
      // Central admin access is selected with the application's authenticated
      // session role, which Firestore rules cannot inspect. Match the other
      // Central reporting reads: authenticated staff may read the immutable
      // month-end aggregate, while portal clients remain excluded.
      allow read: if signedIn() && !isPortalClient();
      allow write: if false;
    }

    // There is one production ledger plus the existing exchange-rate settings
    // document. Staff configuration streams query this collection, so staff
    // may read it while writes are restricted to those two known documents.
    match /management/{documentId} {
      allow read: if signedIn() && !isPortalClient();
      allow write: if signedIn() &&
        !isPortalClient() &&
        (
          documentId == 'CWGXCLYchpm95b3KjoDJ' ||
          documentId == 'singleton'
        );

      match /{subPath=**} {
        allow read: if signedIn() && !isPortalClient();
        allow write: if false;
      }
    }

    // Reusable blank PDFs for the investigation team. Investigators can read
    // and download them, while only application administrators can add,
    // replace, archive, or restore library entries.
    match /investigationDocuments/{documentId} {
      allow read: if signedIn() && !isPortalClient();
      allow create, update, delete: if isAppAdmin();
    }

    // Migration controls are readable for diagnostics, but only an app admin
    // may change a rollout or activate a rollback. Backend migration tools use
    // the Admin SDK and are not governed by these client rules.
    match /migrationControls/{controlId} {
      allow read: if signedIn() && !isPortalClient();
      allow write: if isAppAdmin();
    }

    match /firestoreMigrationRuns/{runId} {
      allow read, write: if false;
    }

    match /{topCollection}/{docId} {
      allow read, write: if signedIn() &&
        !isPortalClient() &&
        !isRestrictedTopCollection(topCollection);

      match /{subPath=**} {
        allow read, write: if signedIn() &&
          !isPortalClient() &&
          !isRestrictedTopCollection(topCollection);
      }
    }
  }
}
